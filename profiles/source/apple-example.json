{
  "schemaVersion": "apple-source.v1",
  "target": "apple",
  "platforms": ["ios", "ipados"],
  "profile": {
    "PayloadDisplayName": "Network Configuration Example",
    "PayloadIdentifier": "com.example.network.configuration",
    "PayloadType": "Configuration",
    "PayloadUUID": "11111111-1111-4111-8111-111111111111",
    "PayloadVersion": 1,
    "payloads": [
      {
        "PayloadType": "com.apple.wifi.managed",
        "PayloadIdentifier": "com.example.network.configuration.wifi",
        "PayloadUUID": "22222222-2222-4222-8222-222222222222",
        "PayloadVersion": 1,
        "Content": {
          "SSID_STR": "ExampleWiFi",
          "AutoJoin": true
        }
      }
    ]
  },
  "declarations": [
    {
      "Type": "com.apple.configuration.app.settings",
      "Identifier": "33333333-3333-4333-8333-333333333333",
      "ServerToken": "replace-with-mdm-server-token",
      "Payload": {
        "Privacy": {
          "PermissionDefaults": {
            "com.example.app": {
              "Camera": "Allow"
            }
          }
        }
      }
    }
  ],
  "mdmCommands": [
    {
      "RequestType": "Settings",
      "Command": {
        "Settings": [
          {
            "Item": "ApplicationConfiguration",
            "Identifier": "com.example.app",
            "Configuration": {
              "enabled": true
            }
          }
        ]
      }
    }
  ]
}
