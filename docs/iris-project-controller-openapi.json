{
  "openapi": "3.0.3",
  "info": {
    "title": "IRIS Project Controller API",
    "version": "1.1.0",
    "description": "Persistent project controller for IRIS-CORE-001. Reads project snapshots and commits checkpoints."
  },
  "servers": [
    {
      "url": "https://jxpqkaevlqhddovpvjib.supabase.co/functions/v1/project-controller"
    }
  ],
  "securitySchemes": {
    "bearerAuth": {
      "type": "http",
      "scheme": "bearer",
      "bearerFormat": "JWT"
    }
  },
  "components": {
    "schemas": {
      "ProjectSnapshot": {
        "type": "object",
        "additionalProperties": true
      },
      "CheckpointRequest": {
        "type": "object",
        "required": [
          "state",
          "reason"
        ],
        "properties": {
          "state": {
            "type": "object",
            "additionalProperties": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "event_type": {
            "type": "string",
            "default": "checkpoint"
          }
        }
      }
    }
  },
  "paths": {
    "/": {
      "get": {
        "operationId": "getProjectSnapshot",
        "summary": "Get persistent project snapshot",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "project_key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "example": "IRIS-CORE-001"
          }
        ],
        "responses": {
          "200": {
            "description": "Project snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectSnapshot"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Controller error"
          }
        }
      },
      "post": {
        "operationId": "commitProjectCheckpoint",
        "summary": "Commit a project checkpoint",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "project_key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "example": "IRIS-CORE-001"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckpointRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Checkpoint committed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectSnapshot"
                }
              }
            }
          },
          "400": {
            "description": "Invalid checkpoint request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Controller error"
          }
        },
        "x-openai-isConsequential": true
      }
    }
  }
}
